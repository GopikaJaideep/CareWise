# CareWise environment configuration
# Copy this file to .env and fill in your values

# REQUIRED — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# REQUIRED for production — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Optional — defaults shown
LLM_MODEL=claude-sonnet-4-5-20250929
DATABASE_URL=sqlite+aiosqlite:///./carewise.db
DEBUG=false
