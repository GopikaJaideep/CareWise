# CareWise environment configuration
# Copy this file to .env and fill in your values

# LLM provider — set ONE of these (or neither for demo mode).
# Free option: get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Paid option: https://console.anthropic.com
ANTHROPIC_API_KEY=
# auto (default) prefers Gemini if its key is set, then Anthropic. Or force: gemini | anthropic
LLM_PROVIDER=auto

# REQUIRED for production — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Optional — defaults shown
LLM_MODEL=claude-sonnet-4-5-20250929
# SQLite is fine locally. For a hosted deployment use Postgres, or data is wiped on each deploy:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./carewise.db
DEBUG=false

# Optional — CORS_ORIGINS as a plain comma-separated string, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Optional — forgot-password emails via Resend (resend.com, free tier).
# Reset links are logged server-side instead of emailed if left blank.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CareWise <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173

# Optional — Web Push reminders (morning motivation + 5-min-before task alerts).
# Generate a pair with: python -c "from py_vapid import Vapid; ..." (see docs/ARCHITECTURE.md)
# Reminders are silently skipped if these are left blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com
MORNING_REMINDER_HOUR_UTC=8
